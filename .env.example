# HydroPhysics AI Configuration
APP_NAME=HydroPhysics AI
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Data Directories
DATA_DIR=data
CAMELS_GB_DIR=data/sample_camels_gb
MODELS_DIR=models_storage
EXPERIMENTS_DIR=experiments/results

# Model Training Defaults
DEFAULT_LOOKBACK=30
DEFAULT_HORIZON=1
DEFAULT_HIDDEN_DIM=64
DEFAULT_NUM_LAYERS=2
DEFAULT_DROPOUT=0.2
DEFAULT_BATCH_SIZE=32
DEFAULT_EPOCHS=20
DEFAULT_LEARNING_RATE=0.005
DEFAULT_PHYSICS_WEIGHT=0.1
RANDOM_SEED=42
